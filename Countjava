public class CountingSort {
    public static void main(String[] args) {
        int[] arr = {4, 2, 2, 8, 3, 3, 1};

        int max = arr[0];
        for (int num : arr)
            if (num > max)
                max = num;

        int[] count = new int[max + 1];

        for (int num : arr)
            count[num]++;

        System.out.print("Sorted Array: ");
        for (int i = 0; i < count.length; i++) {
            while (count[i] > 0) {
                System.out.print(i + " ");
                count[i]--;
            }
        }
    }
}
